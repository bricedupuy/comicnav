# Public API container
API_PORT=8000
MEMORY_LIMIT=8G
DEFAULT_MODEL=inkwell-yolov8n
DEVICE=cpu
MAX_UPLOAD_MB=20
MAX_IMAGE_PIXELS=60000000
HF_TOKEN=

# Optional GCD account for metadata lookup; blank uses anonymous access.
# Configure both values in Dokploy secrets; never enter them in the editor.
GCD_USERNAME=
GCD_PASSWORD=

# Local Compose PostgreSQL. Use a long random value in Dokploy.
POSTGRES_DB=comicnav
POSTGRES_USER=comicnav
POSTGRES_PASSWORD=change-this-before-deploying

# Leave blank to use the PostgreSQL service above. Set this only when using a
# managed database; URL-encode credentials that contain reserved URL characters.
DATABASE_URL=
